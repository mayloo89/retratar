#!/bin/sh
# Enable with: git config core.hooksPath .githooks
#
# Fast checks only. Anything slower than a couple of seconds belongs in CI;
# a slow hook is a hook people bypass with --no-verify.
set -e

unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
	echo "gofmt would change these files:"
	echo "$unformatted"
	echo "run: gofmt -w ."
	exit 1
fi

# Host-local secrets must never be committed, whatever .gitignore says: a real
# .env, deploy/retratar.env, and anything under deploy/postgres-tls/ (the
# server certificate and key). The .env.example and deploy/retratar.env.example
# templates are documented and are expected in the repository.
secrets=$(git diff --cached --name-only \
	| grep -E '(^|/)\.env($|\.)|(^|/)deploy/retratar\.env$|^deploy/postgres-tls/' \
	| grep -vE '(^|/)\.env\.example$' || true)
if [ -n "$secrets" ]; then
	echo "refusing to commit host-local secret files:"
	echo "$secrets"
	exit 1
fi

go vet ./...
