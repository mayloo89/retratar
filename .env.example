# Copy to .env for local development. .env is gitignored; never commit it.

ENV=development
ADDR=:8080

# The two surfaces must be different registrable domains. The process refuses
# to start otherwise: a page served inside the app's origin can read the
# session cookie. See internal/config.Config.Validate.
#
# Production: APP_HOST=retratar.com.ar  PAGES_HOST=retrat.ar
APP_HOST=app.localhost:8080
PAGES_HOST=pages.localhost:8080

# Diagnostics: pprof, expvar, /version. Must bind to loopback — the process
# refuses to start otherwise. Set empty to disable.
ADMIN_ADDR=127.0.0.1:8081

SHUTDOWN_TIMEOUT=15s

# Postgres. `make db-up` starts the container this points at.
#
# sslmode=disable is fine for a container on loopback and refused in production:
# it would put the password, and every row after it, on the wire in clear.
DATABASE_URL=postgres://retratar:retratar@127.0.0.1:5432/retratar?sslmode=disable

# SMTP relay for magic-link email. Required in production — the process
# refuses to start without all five, since a magic link with nowhere to send
# it is a login nobody can complete. Unused in development: mail is logged
# instead of sent (internal/mail.LogSender), so leave these blank locally.
#
# Production (Postmark): SMTP_HOST=smtp.postmarkapp.com  SMTP_PORT=587
# SMTP_USERNAME and SMTP_PASSWORD are both the Postmark Server API Token.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
