# Copy to deploy/retratar.env on the Pi and fill in real values. Never commit
# the filled-in file — deploy/retratar.env is gitignored on purpose.
#
# Read by both services in docker-compose.yml: postgres via POSTGRES_PASSWORD
# alone, app via env_file (all of these).

ENV=production
ADDR=127.0.0.1:8082
ADMIN_ADDR=127.0.0.1:8083
APP_HOST=retratar.com.ar
PAGES_HOST=retrat.ar
SHUTDOWN_TIMEOUT=15s

# POSTGRES_PASSWORD and the password inside DATABASE_URL must be the same
# value, spelled out in both places — env_file entries are not interpolated
# against each other, so ${POSTGRES_PASSWORD} inside DATABASE_URL would be
# passed through literally, not substituted. DATABASE_URL's host is
# 127.0.0.1 because the app container runs with network_mode: host — see
# docs/decisions/0005-run-postgres-and-the-app-in-docker.md for why. Port is
# 5433, not 5432: the Pi's native postgresql@15-main already holds 5432.
# sslmode=require, not disable: config.Config.Validate refuses sslmode=disable
# whenever ENV=production, with no loopback exception — see the docker-compose
# comment on the postgres service for the TLS setup this requires.
#
# DATABASE_URL is parsed as a URL, so the password inside it must not contain
# characters a URL gives meaning to (@ : / ? # %) unless they are percent-
# encoded — one of those appearing raw silently changes where pgx thinks the
# host or path starts, rather than failing loudly. Generate the password with
# something that only ever produces URL-safe characters, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# (alphanumeric plus - and _ only — never needs encoding). If you use
# something else, run the password through Python's urllib.parse.quote (or
# equivalent) before pasting it into DATABASE_URL, and paste the original,
# unencoded value into POSTGRES_PASSWORD.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://retratar:REPLACE_WITH_SAME_PASSWORD_AS_ABOVE@127.0.0.1:5433/retratar?sslmode=require

# Brevo (or any SMTP relay). SMTP_USERNAME/PASSWORD are the account's SMTP
# login and key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@retratar.com.ar
